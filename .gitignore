# CMake 构建目录（in-source 与 out-of-source 均覆盖）
build/
build-*/
cmake-build-*/
out/

# CMake 在构建目录外生成的缓存与中间文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# 编译产物（不要忽略 *.obj，本仓库中 .obj 是 Wavefront 模型文件）
*.o
*.a
*.so
*.dylib
*.exe
*.pdb

# 渲染输出
binary.ppm
binary.png

# 编辑器与系统文件（只忽略根目录的本地配置，各作业内的 .vscode 仍受版本控制）
/.vscode/
.idea/
.DS_Store
Thumbs.db

# macOS 解压产生的元数据
__MACOSX/
